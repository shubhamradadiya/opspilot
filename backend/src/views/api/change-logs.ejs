              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">GET</span> /api/v1/admin/dashboard</code>
                <br />
                &#10003; Get admin dashboard data (admin only)
              </li>
            </ul>

            <h6 class="mt-3 h6">06 Feb, 2026</h6>
            <span class="badge badge-primary">App Api</span>
            <ul class="mt-3">
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">POST</span> /api/v1/expense</code>
                <br />
                &#10003; Create expense
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">GET</span> /api/v1/expenses</code>
                <br />
                &#10003; Get all expenses
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">PUT</span> /api/v1/expense/:eId</code>
                <br />
                &#10003; Update expense
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">DELETE</span> /api/v1/expense/:eId</code>
                <br />
                &#10003; Delete expense
              </li>
            </ul>

            <h6 class="mt-3 h6">02 Feb, 2026</h6>
            <span class="badge badge-primary">App Api</span>
            <ul class="mt-3">
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">POST</span> /api/v1/inventory</code>
                <br />
                &#10003; Create inventory
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">GET</span> /api/v1/inventory</code>
                <br />
