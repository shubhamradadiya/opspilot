              </li>
            </ul>

            <h6 class="mt-3 h6">27 Jan, 2026</h6>
            <span class="badge badge-primary">App Api</span>
            <ul class="mt-3">
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">POST</span> /api/v1/attendance/check-status</code>
                <br />
