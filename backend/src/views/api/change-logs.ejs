              </li>
              <li class="text-muted ml-3 mb-2">
                <code
                  ><span class="api-method">GET</span>
                  /api/v1/attendance/timestamps
                </code>
                <br />
                &#10003; Get attendance timestamps of all users by days or weeks (admin only)
              </li>
              <li class="text-muted ml-3 mb-2">
                <code
                  ><span class="api-method">POST</span>
                  /api/v1/payout/add-loan
                </code>
                <br />
                &#10003; Add loan for user (admin only)
              </li>
              <li class="text-muted ml-3 mb-2">
                <code
                  ><span class="api-method">POST</span>
                  /api/v1/payout
                </code>
                <br />
                &#10003; Create payout for user (admin only)
              </li>
              <li class="text-muted ml-3 mb-2">
                <code
                  ><span class="api-method">GET</span>
                  /api/v1/payouts/self-payouts
                </code>
                <br />
                &#10003; Get logged in user's payout list (self payouts)
              </li>
              <li class="text-muted ml-3 mb-2">
                <code
                  ><span class="api-method">GET</span>
                  /api/v1/payouts/all-payouts
                </code>
                <br />
