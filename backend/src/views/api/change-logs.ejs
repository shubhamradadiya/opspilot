              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">DELETE</span> /api/v1/inventory/:iId</code>
                <br />
                &#10003; Delete inventory
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">PUT</span> /api/v1/inventory/:iId</code>
                <br />
                &#10003; Update inventory
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">GET</span> /api/v1/inventory/activity-logs</code>
                <br />
