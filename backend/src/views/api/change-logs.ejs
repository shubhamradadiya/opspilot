              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">PUT</span> /api/v1/ring-customer/:rcId</code>
                <br />
                &#10003; Update ring customer
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">DELETE</span> /api/v1/ring-customer/:rcId</code>
                <br />
                &#10003; Delete ring customer
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">GET</span> /api/v1/expense/vendor-names</code>
                <br />
