              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">GET</span> /api/v1/user</code>
                <br />
                &#10003; User login user's details
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">GET</span> /api/v1/employee</code>
                <br />
                &#10003; Get all employees (admin only)
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">POST</span> /api/v1/employee</code>
                <br />
                &#10003; Create employee (admin only)
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">PUT</span> /api/v1/employee/:uid</code>
                <br />
                &#10003; Update employee (admin only)
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">PATCH</span> /api/v1/employee/:uid/status</code>
                <br />
                &#10003; Update employee status (admin only)
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">DELETE</span> /api/v1/employee/:uid</code>
                <br />
                &#10003; Delete employee (admin only)
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
