              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">GET</span> /api/v1/attendance/logs</code>
                <br />
                &#10003; Get logged in or passed user's attendance logs
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">DELETE</span> /api/v1/attendance/logs</code>
                <br />
                &#10003; Delete user logs manually (admin only)
              </li>
            </ul>

            <h6 class="mt-3 h6">09 Feb, 2026</h6>
            <span class="badge badge-primary">App Api</span>
            <ul class="mt-3">
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">POST</span> /api/v1/attendance/log</code>
                <br />
                &#10003; Add manual user log (admin only)
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">POST</span> /api/v1/ring-customer</code>
                <br />
                &#10003; Create ring customer
              </li>
              <li class="text-muted ml-3 mb-2">
                <code><span class="api-method">GET</span> /api/v1/ring-customers</code>
                <br />
